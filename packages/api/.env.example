# Field Intake Service - Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real credentials

# Anthropic API Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Telegram Invitation System (for production use)
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_TOKEN_SECRET_NAME=field-intake/dev/telegram-bot-token
TELEGRAM_INVITATION_TTL_SECONDS=3600

# SMS Configuration (Issue #37)
USE_AWS_SNS=false  # Set to 'true' to use AWS SNS for SMS
AWS_SNS_SENDER_ID=FieldIntake  # Optional: SMS sender ID

# AWS Configuration
# Get credentials from: ./infra/scripts/setup-iam.sh
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
# AWS_PROFILE=field-intake-service-dev  # Optional: use named profile instead of keys
